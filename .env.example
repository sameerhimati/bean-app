# Bean — copy to `.env` and fill in. `.env` is gitignored; never commit real keys.

# Required: classify/draft/judge calls + the live calibration eval hit the Claude API.
ANTHROPIC_API_KEY=sk-ant-...

# ---- deployment ------------------------------------------------------------------------------
# Set to "production" in a real deployment. It makes the auth checks FAIL CLOSED: with BEAN_ENV
# unset (local dev, tests) a missing passcode merely disables the gate, which is convenient — but
# in production that same missing var would silently serve every customer email to the open
# internet. Production refuses to serve rather than serve unguarded.
# BEAN_ENV=production

# The single shared passcode for the web UI (the cookie value IS this secret). REQUIRED in
# production. Use a long random string — it is typed once per device, not memorized.
# BEAN_PASSCODE=

# Shared secret for the Postmark inbound webhook, which cannot send a cookie. REQUIRED in
# production. It rides on the URL query string, so it leaks into any log that records URLs —
# Bean redacts its own access log, but prefer HTTP Basic auth on the webhook if you can.
# BEAN_INBOUND_TOKEN=

# Where JSONL + config persist. A mounted volume in production; defaults to ./data locally.
# BEAN_DATA_DIR=/data

# The forwarding address the onboarding screen shows the customer (display only).
# BEAN_INBOUND_ADDRESS=

# The tenant directory under BEAN_DATA_DIR this process serves. REQUIRED in production — with
# BEAN_ENV=production and this unset the server refuses to start, because the default is the demo
# store and serving that to a real deployment overwrites their config on the first save.
# BEAN_CUSTOMER=

# Where THIS deployment is reachable, e.g. https://bean.example.com. Not read by the server — it is
# for the operator-side tooling: scripts/deploy.sh polls $BEAN_PUBLIC_URL/healthz for the SHA it
# just shipped, and the auth snippet in CLAUDE.md builds its curl from it. Kept here rather than
# written into either, so no file in this repo names a live instance (CLAUDE.md is public, and
# deploy.sh hardcoded one host until a fork would have polled somebody else's production).
# BEAN_PUBLIC_URL=

# ---- the public demo -------------------------------------------------------------------------
# The three vars the public demo service sets, and NOTHING else — in particular it is deployed with
# NO ANTHROPIC_API_KEY, because a URL anyone can open must not be able to spend money. Its tenant is
# seeded from committed fixtures at boot (scripts/seed_demo_tenant.py); see bean/demo.py.
#
# BEAN_DEMO_READONLY makes every write route answer 404: nothing persists, nothing spends a token,
# and a visitor's clicks live only in their browser until they refresh. 404 rather than 403 is
# deliberate — the frontend reads a 404 write as "no backend here" and stays silent, while any other
# status raises an error toast at someone who did nothing wrong. See bean/server.py.
#
# LEAVE BEAN_ENV UNSET on the demo service. BEAN_ENV=production makes the passcode gate fail CLOSED,
# so a demo with no BEAN_PASSCODE would answer 503 to every page and every read — i.e. the two
# settings a public demo obviously wants ("production" + "no passcode") combine into a dead site.
# The consequence of leaving it unset is that every GET is public, which is the point here and is
# only safe because this tenant holds nothing real: fictional store, fictional mail, no corrections.
# BEAN_CUSTOMER=sablewren
# BEAN_DEMO_READONLY=1
# BEAN_DEMO_TENANT=1

# ---- optional --------------------------------------------------------------------------------
# Model overrides (defaults set in bean/llm.py).
# BEAN_MODEL_CLASSIFY=claude-haiku-4-5
# BEAN_MODEL_DRAFT=claude-sonnet-4-6
# BEAN_MODEL_JUDGE=claude-opus-4-8

# Turn request logging down if it gets noisy (default INFO).
# BEAN_LOG_LEVEL=INFO
